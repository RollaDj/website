# Copier en .env.local pour le développement, ou définir ces variables
# dans Vercel > Project > Settings > Environment Variables.
# Ne jamais versionner de vraie clé : .env.local est ignoré par git.

# ── Site ────────────────────────────────────────────────────────────────────
# URL publique définitive (URL canoniques, sitemap, Open Graph).
# Facultatif sur Vercel : à défaut, l'URL de production Vercel est utilisée.
NEXT_PUBLIC_SITE_URL=https://www.rolladj.com

# Indexation par les moteurs de recherche.
# Laisser à "false" tant que le nouveau site ne remplace pas rolladj.com.
ALLOW_INDEXING=false

# ── Formulaire de contact (Resend — https://resend.com) ─────────────────────
# Sans ces trois variables, le formulaire indique honnêtement qu'il n'est pas
# encore relié et propose l'e-mail direct : aucune fausse confirmation.
RESEND_API_KEY=
# Adresse qui reçoit les demandes
CONTACT_TO_EMAIL=booking@rolladj.com
# Expéditeur : adresse d'un domaine vérifié dans Resend
CONTACT_FROM_EMAIL="ROLLA — site <site@rolladj.com>"
