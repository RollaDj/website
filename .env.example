# Copier en .env.local pour le développement, ou définir ces variables
# dans Vercel > Project > Settings > Environment Variables.

# URL publique définitive (URLs canoniques, sitemap, Open Graph).
# Facultatif sur Vercel : à défaut, l'URL de production Vercel est utilisée.
NEXT_PUBLIC_SITE_URL=https://www.rolladj.com

# Indexation par les moteurs de recherche.
# Laisser à "false" tant que le nouveau site ne remplace pas rolladj.com,
# pour ne pas créer de contenu dupliqué. Passer à "true" le jour de la bascule.
ALLOW_INDEXING=false
